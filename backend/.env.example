# FastAPI Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:3000", "http://127.0.0.1:5173"]

# PostgreSQL Database Connection
# Standard PostgreSQL URL: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/flood_db

# Alternative SQLite connection for development when PostgreSQL is not running locally:
# DATABASE_URL=sqlite:///./flood_db.db
